# Capacitor / iOS
# The ios/ folder is regenerated entirely by `pnpm cap:add:ios`. Capacitor's
# generated Package.swift contains absolute paths to node_modules/.pnpm/...
# which are not portable across machines, and ios/App/App/public/ is just a
# copy of dist/. Source-of-truth for our custom EventKit plugin lives in
# capacitor/EventKitPlugin/ (committed); the install script copies it into
# the regenerated ios/ tree.
#
# If we later need to commit Xcode-side capabilities (push entitlements,
# signing config, custom build phases), we can selectively un-ignore
# ios/App/App.xcodeproj/project.pbxproj and ios/App/App/App.entitlements
# at that point.
ios
*.xcuserstate
*.xcworkspace/xcuserdata
*.xcodeproj/xcuserdata
*.xcodeproj/project.xcworkspace/xcuserdata
