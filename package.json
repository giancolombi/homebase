{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:api",
    "typecheck:app": "tsc --noEmit -p app/tsconfig.json",
    "typecheck:api": "tsc --noEmit -p api/tsconfig.json",
    "lint:strict": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "server": "tsx api/index.ts",
    "server:dev": "tsx watch api/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-local.ts",
    "cap:add:ios": "pnpm run build && cap add ios && pnpm run cap:install:plugins",
    "cap:sync": "pnpm run build && cap sync ios && pnpm run cap:install:plugins",
    "cap:open:ios": "cap open ios",
    "cap:run:ios": "pnpm run cap:sync && cap run ios",
    "cap:install:plugins": "node scripts/install-eventkit-plugin.mjs",
    "prepare": "node .husky/install.mjs"
  },
