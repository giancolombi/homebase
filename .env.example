# Copy to .env and fill in values. The API loads this automatically in dev
# (api/lib/env.ts); real environment variables always take precedence.
# NEVER commit .env — it is gitignored.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/homebase

# Secret for signing auth/invite/reset JWTs. Required — the API refuses to
# start without it. Generate with: openssl rand -hex 32
JWT_SECRET=

# Port for the Express API (default 3001)
API_PORT=3001

# Public URL of the web app — used in emails and OAuth redirects
APP_URL=http://localhost:8080

# 32-byte hex key for encrypting OAuth/CalDAV/Plaid tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Google Calendar OAuth (optional — calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/callback/google

# Microsoft Outlook OAuth (optional — calendar sync)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/calendar/callback/outlook

# Resend (optional — transactional email; logs to console when unset)
RESEND_API_KEY=

# Extra allowed browser origins for CORS, comma-separated (optional)
# CORS_ORIGINS=
