# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).

# Node environment: "development" | "production". The reset-token debug
# response and insecure secret fallbacks only apply in development.
NODE_ENV="development"

# PostgreSQL connection
DATABASE_URL="postgresql://localhost:5432/homebase"

# JWT secret for auth tokens. REQUIRED in production — the server refuses to
# boot without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# API server port
API_PORT=3001

# App URL (for OAuth redirects back to frontend)
APP_URL="http://localhost:8080"

# Comma-separated CORS allowlist of browser origins.
CORS_ORIGINS="https://gethomebase.dev,http://localhost:8080,capacitor://localhost"

# Encryption key for OAuth/Plaid tokens at rest (32 bytes hex). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# Google Calendar OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/callback/google"

# Microsoft Outlook OAuth (https://portal.azure.com)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3001/api/calendar/callback/outlook"

# Resend email service (https://resend.com)
RESEND_API_KEY=""

# Plaid (https://dashboard.plaid.com). PLAID_ENV: sandbox | development | production
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# Apple Push Notifications (token-based .p8). When unset, push sends no-op.
# APNS_KEY holds the .p8 contents (newlines may be \n-escaped).
APNS_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID=""
APNS_PRODUCTION="false"
